# ====================================
# DATABASE CONFIGURATION
# ====================================

# PostgreSQL only
# Replace with your actual PostgreSQL credentials
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/cost_estimator
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/cost_estimator

# Database Connection Pool Settings (PostgreSQL only)
# These settings optimize connection pooling for better performance
DB_POOL_SIZE=20          # Maximum number of connections in the pool
DB_MAX_OVERFLOW=10       # Additional connections allowed beyond pool_size
DB_POOL_TIMEOUT=30       # Seconds to wait for connection from pool
DB_POOL_RECYCLE=3600     # Seconds before recycling connections (1 hour)

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# LlamaParse (required for document parsing)
LLAMA_PARSE_API_KEY=your_llama_parse_api_key_here

# AI Providers
# Set AI_PROVIDER=openai to use ChatGPT as primary with Claude as automatic fallback
# Set AI_PROVIDER=claude to use Claude only
# Set AI_PROVIDER=groq to use Groq only
AI_PROVIDER=openai

# OpenAI (primary)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o

# Anthropic / Claude (fallback when AI_PROVIDER=openai)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_DRAWING=claude-sonnet-4-20250514
# Claude drawing PDF ingestion mode: images (recommended) | auto | native_pdf
CLAUDE_DRAWING_PDF_MODE=images
# Rendering DPI when images mode is used
CLAUDE_DRAWING_IMAGE_DPI=300
CLAUDE_DRAWING_DENSE_DPI=400

# Groq (optional alternative)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_LARGE=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# File Storage (local for MVP, swap to azure/s3 later)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_CONTAINER_NAME=cost-estimator
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=
# AWS_REGION=

# App
APP_NAME=CostEstimatorAgent
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development

# ====================================
# AUTHENTICATION
# ====================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=cost-estimator-api
JWT_AUDIENCE=cost-estimator-web

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

REFRESH_COOKIE_NAME=cost_estimator_refresh
CSRF_COOKIE_NAME=cost_estimator_csrf

# Set to false only for local HTTP development
COOKIE_SECURE=true
# lax | strict | none  (use "none" only with COOKIE_SECURE=true and explicit CORS origins)
# REQUIRED: use "none" when frontend and backend are on different domains (e.g. an Azure Static
# Web App calling an Azure App Service backend) — SameSite=lax cookies are never attached to
# cross-site fetch/XHR requests, which silently breaks refresh-token restore and CSRF checks.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/api/auth

FRONTEND_URL=http://localhost:5173

PASSWORD_RESET_EXPIRE_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# user | estimator — role granted to publicly self-registered accounts.
# Admin accounts must be created by an existing administrator; never trust a client-supplied role.
DEFAULT_SIGNUP_ROLE=user

AUTH_CLEANUP_INTERVAL_HOURS=6
REVOKED_TOKEN_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=180

# ====================================
# RBAC SYSTEM-ACCOUNT BOOTSTRAP (one-time, idempotent)
# ====================================
# Creates/repairs the admin, manager, and estimator system accounts on startup or via
# `python -m app.scripts.bootstrap_rbac_users`. Set to false once the accounts exist in this
# environment. In Azure, set these in App Service > Environment variables or Key Vault — never
# commit real values to source control.
BOOTSTRAP_RBAC_USERS=false

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_USERNAME=
BOOTSTRAP_MANAGER_FULL_NAME=
BOOTSTRAP_MANAGER_PASSWORD=

BOOTSTRAP_ESTIMATOR_EMAIL=
BOOTSTRAP_ESTIMATOR_USERNAME=
BOOTSTRAP_ESTIMATOR_FULL_NAME=
BOOTSTRAP_ESTIMATOR_PASSWORD=

# Only true when you intentionally need to force-reset these three accounts' passwords.
BOOTSTRAP_UPDATE_EXISTING_PASSWORDS=false


# Company Branding (for cover letters)
COMPANY_NAME=Your Engineering Company
COMPANY_ADDRESS=123 Industrial Zone, City, Country
COMPANY_PHONE=+1-234-567-8900
COMPANY_EMAIL=info@yourcompany.com
COMPANY_WEBSITE=www.yourcompany.com
SIGNATORY_NAME=Project Manager
SIGNATORY_TITLE=Head of Fabrication

